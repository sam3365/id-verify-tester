# Copy this file to .env.local — Next.js loads it automatically.

# ─── Didit API Key ─────────────────────────────────────────────────────────────
# Found in: https://business.didit.me → API & Webhooks → API Keys
# Create a separate Sandbox application for testing and a Live application for
# production. Each application has its own API key.
DIDIT_API_KEY=your_didit_api_key_here

# ─── Didit Workflow ID ─────────────────────────────────────────────────────────
# A Workflow defines which verification steps run (ID check, liveness, face
# match, AML, etc.). Create one in: https://business.didit.me → Workflows
# Each workflow has a stable UUID — copy it from the workflow's detail page.
# You can have separate workflow IDs for sandbox vs. production.
DIDIT_WORKFLOW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── App Base URL ─────────────────────────────────────────────────────────────
# Used to build the callback URL Didit redirects users back to after
# completing the hosted verification flow.
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Didit Webhook Secret ─────────────────────────────────────────────────────
# Per-destination secret from the Business Console:
# https://business.didit.me → API & Webhooks → Add Webhook Destination
# The secret (secret_shared_key) is shown once at creation — store it now.
# Used to verify HMAC-SHA256 signatures on incoming webhook events.
DIDIT_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Upstash Redis (for webhook event persistence on Vercel) ──────────────────
# Add the Upstash Redis integration from the Vercel Marketplace:
# https://vercel.com/marketplace?category=storage&search=redis
# Vercel auto-injects these vars when you connect the integration.
# Pull them locally with:  vercel env pull .env.local
# When absent, an in-memory store is used (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Test Data (optional) ─────────────────────────────────────────────────────
# Pre-seed a known session ID for the retrieve and decision tests.
# After running a real verification, paste the session_id here.
TEST_SESSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
