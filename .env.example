# Copy this file to .env.local — Next.js loads it automatically.

# ─── Stripe Secret Key ─────────────────────────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
# Test mode starts with sk_test_   Live mode starts with sk_live_
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe Publishable Key (client-side) ─────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
# Test mode starts with pk_test_   Live mode starts with pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe Webhook Signing Secret ────────────────────────────────────────────
# Created in: https://dashboard.stripe.com/webhooks
# Starts with: whsec_
# For local dev use the Stripe CLI:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── App Base URL ─────────────────────────────────────────────────────────────
# Used to build return_url / refresh_url for verification sessions.
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Environment label ────────────────────────────────────────────────────────
# "test" or "live" — purely cosmetic, shown in the UI header badge.
# The tester auto-detects mode from the key prefix (sk_test_ vs sk_live_).
STRIPE_ENV_LABEL=test

# ─── Upstash Redis (for webhook event persistence on Vercel) ──────────────────
# Add the Upstash Redis integration from the Vercel Marketplace:
# https://vercel.com/marketplace?category=storage&search=redis
# Vercel auto-injects these vars when you connect the integration.
# Pull them locally with:  vercel env pull .env.local
# When absent, an in-memory store is used (local dev default).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Test Data (optional) ─────────────────────────────────────────────────────
# Pre-seed a known VerificationSession ID for the retrieve/cancel tests.
TEST_VERIFICATION_SESSION_ID=vs_xxxxxxxxxxxxxxxxxxxxxxxx

# Pre-seed a known VerificationReport ID for the retrieve tests.
TEST_VERIFICATION_REPORT_ID=vr_xxxxxxxxxxxxxxxxxxxxxxxx
