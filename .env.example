# Copy this file to .env.local — Next.js loads it automatically.

# ─── Didit API Key ─────────────────────────────────────────────────────────────
# Found in: https://business.didit.me → API & Webhooks → API Keys
# Create a separate Sandbox application for testing and a Live application for
# production. Each application has its own API key.
DIDIT_API_KEY=your_didit_api_key_here

# ─── Didit Workflow ID ─────────────────────────────────────────────────────────
# A Workflow defines which verification steps run (ID check, liveness, face
# match, AML, etc.). Create one in: https://business.didit.me → Workflows
# Each workflow has a stable UUID — copy it from the workflow's detail page.
# You can have separate workflow IDs for sandbox vs. production.
DIDIT_WORKFLOW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── App Base URL ─────────────────────────────────────────────────────────────
# Used to build the callback URL Didit redirects users back to after
# completing the hosted verification flow.
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Didit Webhook Secret ─────────────────────────────────────────────────────
# Per-destination secret from the Business Console:
# https://business.didit.me → API & Webhooks → Add Webhook Destination
# The secret (secret_shared_key) is shown once at creation — store it now.
# Used to verify HMAC-SHA256 signatures on incoming webhook events.
DIDIT_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Upstash Redis (for webhook event persistence on Vercel) ──────────────────
# Add the Upstash Redis integration from the Vercel Marketplace:
# https://vercel.com/marketplace?category=storage&search=redis
# Vercel auto-injects these vars when you connect the integration.
# Pull them locally with:  vercel env pull .env.local
# When absent, an in-memory store is used (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Default Vendor Data (optional) ──────────────────────────────────────────
# Pre-fills the "User ID (vendor_data)" field on the /verify page.
# Useful during testing so you don't have to retype your user ID each time.
# In production, your app will supply this value programmatically instead.
NEXT_PUBLIC_DEFAULT_VENDOR_DATA=

# ─── Default Session ID for Lookup (optional) ─────────────────────────────────
# Pre-fills the session_id field on the /lookup page.
# Obtain the session_id from:
#   - The webhook envelope: body.session_id on a status.updated / Approved event
#   - The /verify/complete callback URL param: ?verificationSessionId=xxx
#   - The Didit Business Console session list
# The lookup calls GET /v3/session/{id}/decision/ and displays name, DOB,
# address, document type/number, and document front/back + selfie images.
NEXT_PUBLIC_DEFAULT_SESSION_ID=

# ─── Test Data (optional) ─────────────────────────────────────────────────────
# Pre-seed a known session ID for the retrieve and decision tests.
# After running a real verification, paste the session_id here.
TEST_SESSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Age & Gender Review Logic (optional) ──────────────────────────────────────
# Mirrors the production Didit webhook's mismatch checks (see lib/review-logic.js).
# When a live "Approved" webhook arrives at /api/webhooks/didit, its extracted
# gender/DOB/age are compared against these "on-file" values to simulate a
# known member profile — no real database required. Leave unset to skip
# comparison (any extracted gender/age is treated as a first-time match).
TEST_EXPECTED_GENDER=
TEST_EXPECTED_AGE=
TEST_EXPECTED_DOB=

# Admin setting mirrored from the production SiteConfig.verification_mismatch_action.
# "review"      (default) — flag the profile for manual admin review.
# "hard_reject" — automatically reject with an ordered reason code
#                 (underage / photo_mismatch / invalid_id / incomplete_verification).
VERIFICATION_MISMATCH_ACTION=review
